{
  "name": "imaplane",
  "version": "0.2.0",
  "private": false,
  "description": "Imaplane — local IMAP plane for agents and apps. HTTP API + MCP + OpenAPI. iCloud and generic IMAP.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "imaplane": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "openapi.yaml",
    "BOT.md",
    "examples",
    "imaplane.yaml.example"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "mcp": "node dist/mcp.js",
    "init": "node dist/cli.js init",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "launchd:install": "bash scripts/install-launchd.sh",
    "launchd:uninstall": "bash scripts/uninstall-launchd.sh"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "imapflow": "^1.0.186",
    "mailparser": "^3.7.2",
    "nodemailer": "^10.0.1",
    "sanitize-html": "^2.17.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
