# Imaplane — copy to .env and fill in. Never commit .env.
# Generate a token: openssl rand -hex 32

BRIDGE_TOKEN=
HOST=127.0.0.1
PORT=8787

# --- iCloud / Apple Mail (app-specific password, not your Apple ID password) ---
# appleid.apple.com → Sign-In and Security → App-Specific Passwords
ICLOUD_USER=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Optional generic IMAP account (or put these in imaplane.yaml as ${WORK_USER}) ---
# WORK_USER=you@example.com
# WORK_PASSWORD=

# MCP stdio client. Defaults to http://HOST:PORT/v1
# BRIDGE_URL=http://127.0.0.1:8787/v1

# Optional IMAP host override when using env-only iCloud config
# IMAP_HOST=imap.mail.me.com
# IMAP_PORT=993

# Global send opt-in (default off). Prefer send.enabled in imaplane.yaml.
# IMAPLANE_SEND=false
